---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/help.js';
---

<BaseLayout
  title="Page not found — ronsel"
  description="This page does not exist. Head back to the ronsel documentation."
>
  <div class="fl-notfound">
    <p class="fl-kicker">404</p>
    <h2 class="fl-h2" style="max-width:20ch">Page not found</h2>
    <p class="fl-p" style="max-width:52ch">
      The page you are looking for does not exist — it may have moved when the
      documentation was reorganised.
    </p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:32px">
      <a href={withBase('/')} class="fl-cta">← Back home</a>
      <a href={withBase('/docs/')} class="fl-cta fl-cta-plain">Browse the docs</a>
    </div>
  </div>
</BaseLayout>
