---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { orderedTopics, withBase } from '../../lib/help.js';
import { renderMarkdown } from '../../lib/markdown.js';

export function getStaticPaths() {
  return orderedTopics.map((topic, index) => ({
    params: { slug: topic.id },
    props: {
      topic,
      prev: orderedTopics[index - 1] ?? null,
      next: orderedTopics[index + 1] ?? null,
    },
  }));
}

const { topic, prev, next } = Astro.props;
const html = renderMarkdown(topic.body);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: topic.title,
    description: topic.summary,
    url: canonical,
    inLanguage: 'en',
    articleSection: topic.categoryLabel,
    keywords: topic.keywords.join(', '),
    isPartOf: {
      '@type': 'WebSite',
      name: 'ronsel',
      url: new URL(withBase('/'), Astro.site).href,
    },
    author: { '@type': 'Person', name: 'Jose Constela' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'ronsel',
        item: new URL(withBase('/'), Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Documentation',
        item: new URL(withBase('/docs/'), Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: topic.title, item: canonical },
    ],
  },
];
---

<DocsLayout
  title={`${topic.title} — ronsel docs`}
  description={topic.summary}
  activeId={topic.id}
  ogType="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="fl-article-head">
      <p class="fl-article-kicker">{topic.categoryLabel}</p>
      <h1 class="fl-docs-h1">{topic.title}</h1>
      <p class="fl-article-summary">{topic.summary}</p>
    </header>

    <div class="fl-prose" set:html={html} />
  </article>

  <nav class="fl-pager" aria-label="Article navigation">
    {
      prev ? (
        <a href={withBase(`/docs/${prev.id}/`)} class="fl-pager-link">
          <p class="fl-pager-label">← previous</p>
          <p class="fl-pager-title">{prev.title}</p>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a href={withBase(`/docs/${next.id}/`)} class="fl-pager-link fl-pager-next">
          <p class="fl-pager-label">next →</p>
          <p class="fl-pager-title">{next.title}</p>
        </a>
      )
    }
  </nav>
</DocsLayout>
