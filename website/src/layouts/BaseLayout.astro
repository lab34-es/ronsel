---
import '../styles/global.css';
import { withBase } from '../lib/help.js';
import ThemeToggle from '../components/ThemeToggle.astro';

const {
  title,
  description,
  ogType = 'website',
  jsonLd = null,
  navTag = null,
  wide = false,
} = Astro.props;
const repoUrl = 'https://github.com/lab34-es/flows';

// Absolute, trailing-slash canonical URL of this page.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('/og-image.png'), Astro.site).href;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// On the docs the footer points home; everywhere else it points at the docs.
const inDocs = Astro.url.pathname.startsWith(withBase('/docs'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ronsel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ronsel — end-to-end tests as Markdown documents" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      const theme =
        localStorage.getItem('theme') ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body>
    <header class="fl-header">
      <nav class="fl-nav" aria-label="Main">
        <a href={withBase('/')} class="fl-brand">ronsel</a>
        {navTag && <span class="fl-nav-tag">{navTag}</span>}
        <span class="fl-spacer"></span>
        <a
          href={withBase('/docs/')}
          class="fl-navlink"
          aria-current={inDocs ? 'page' : undefined}>docs</a
        >
        <a href={repoUrl} class="fl-navlink">github</a>
        <ThemeToggle />
      </nav>
    </header>

    <main class="fl-main">
      <slot />
    </main>

    <footer class:list={['fl-footer', wide && 'fl-footer-wide']}>
      <div class="fl-footer-inner">
        <span>ronsel</span>
        <span>MIT</span>
        <span class="fl-spacer"></span>
        {
          inDocs ? (
            <a href={withBase('/')}>home</a>
          ) : (
            <a href={withBase('/docs/')}>docs</a>
          )
        }
        <a href={repoUrl}>github</a>
        <a href="https://lab34.es">lab34.es</a>
      </div>
    </footer>
  </body>
</html>
